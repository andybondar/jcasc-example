#!/bin/bash
# Wait for disk to be attached
while [ ! -e ${disk} ]; do
	echo "Waiting for disk ${disk} to be attached..."
	sleep 1
done

echo "Disk ${disk} has been attched. Proceeding."

# Create and format disk partition
echo 'type=83' | sfdisk ${disk}
mkfs.ext4 ${disk}p1

# Create 'jenkins_home' directory
mkdir -p /opt/jenkins_home

# Mount new disk partition to 'jenkins_home' directory
mount ${disk}p1 /opt/jenkins_home

# Modify /etc/fstab
echo "UUID:"
echo $(blkid ${disk}p1 | awk '{print $2}' | awk -F"\"" '{print $2}')
echo "UUID=$(blkid ${disk}p1 | awk '{print $2}' | awk -F"\"" '{print $2}')	/opt/jenkins_home	ext4  defaults,noatime  0  2" >> /etc/fstab

# Add Docker's official GPG key:
apt update -y
apt install ca-certificates curl gnupg lsb-release -y
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

# Add the repository to Apt sources:
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

apt update -y

# Install Docker
apt install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin -y

# Install AWS CLI
snap install aws-cli --classic

# Log in to ECR
aws ecr get-login-password --region eu-central-1 | docker login --username AWS --password-stdin ${aws_account}.dkr.ecr.eu-central-1.amazonaws.com

# Pull image
docker pull ${aws_account}.dkr.ecr.eu-central-1.amazonaws.com/jenkins:jcasc.aws

# Write the Compose file
mkdir /opt/compose
cat <<'EOT' > /opt/compose/docker-compose.yaml
${compose_content}
EOT

sed -i s/AWS_ACCOUNT_PLACEHOLDER/${aws_account}/g /opt/compose/docker-compose.yaml

# Start Docker Compose